{
  "$defs": {
    "QuoteClaim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Claim Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_id",
        "quote"
      ],
      "title": "QuoteClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/QuoteClaim"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "metric_ids": {
      "items": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
        "type": "string"
      },
      "title": "Metric Ids",
      "type": "array"
    },
    "limitation_codes": {
      "items": {
        "enum": [
          "source_truth_unverified",
          "coverage_limited",
          "offline_demo",
          "human_review_required"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitation Codes",
      "type": "array"
    }
  },
  "required": [
    "claims",
    "metric_ids",
    "limitation_codes"
  ],
  "title": "CandidateContent",
  "type": "object"
}
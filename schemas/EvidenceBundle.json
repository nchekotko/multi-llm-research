{
  "$defs": {
    "EvidenceSource": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "uri": {
          "default": "user-provided",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "default": "1",
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "rights": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rights",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "text",
        "available_at",
        "rights",
        "sha256",
        "retrieved_at"
      ],
      "title": "EvidenceSource",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Metric Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "value",
        "unit",
        "operation",
        "source_ids",
        "input_sha256"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/EvidenceSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "sources",
    "metrics",
    "gaps"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Finding Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Rule Id",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required_action": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Required Action",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "rule_id",
        "evidence_ref",
        "description",
        "required_action"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingResolution": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Finding Id",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "reason": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "evidence_ref",
        "reason"
      ],
      "title": "FindingResolution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "approved",
        "changes_required",
        "inconclusive"
      ],
      "title": "Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "resolutions": {
      "items": {
        "$ref": "#/$defs/FindingResolution"
      },
      "title": "Resolutions",
      "type": "array"
    }
  },
  "required": [
    "status",
    "findings",
    "unresolved_questions"
  ],
  "title": "ReviewReport",
  "type": "object"
}